# Build context for the e2e workflow-frontend image (see
# e2e-tests/images/workflow-frontend.Dockerfile). Sources are bind-mounted at
# runtime, so keep the context small: exclude VCS data, dependencies and build
# artifacts. The e2e-tests/target checkout in particular must be excluded.
.git
**/node_modules
**/target
logs
public/build
e2e-tests/test-results
e2e-tests/playwright-report
