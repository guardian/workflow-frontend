#!/usr/bin/env bash

set -euo pipefail

ca_file=/etc/workflow-local-ca/rootCA.pem
ca_alias=workflow-e2e-local-ca

if mise exec java -- keytool -list -cacerts -storepass changeit -alias "$ca_alias" >/dev/null 2>&1; then
    mise exec java -- keytool -delete -cacerts -storepass changeit -alias "$ca_alias"
fi
mise exec java -- keytool -importcert -noprompt -cacerts -storepass changeit \
    -alias "$ca_alias" -file "$ca_file"

exec "$@"