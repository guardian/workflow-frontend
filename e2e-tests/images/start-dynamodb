#!/bin/sh

set -eu

DYNAMODB_PORT="${DYNAMODB_PORT:-8000}"
DYNAMODB_ENDPOINT="http://localhost:${DYNAMODB_PORT}"
TABLE_NAME="${TABLE_NAME:-editorial-support-CODE}"
FIXTURES_FILE="${FIXTURES_FILE:-/opt/dynamodb-fixtures/editorial-support-CODE.json}"

export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-minioadmin}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-minioadmin}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-eu-west-1}"

max_attempts="${DYNAMODB_STARTUP_MAX_ATTEMPTS:-60}"

DYNAMODB_PID=""

shutdown() {
  if [ -n "${DYNAMODB_PID}" ] && kill -0 "${DYNAMODB_PID}" 2>/dev/null; then
    echo "Stopping DynamoDB Local (PID ${DYNAMODB_PID})..."
    kill -TERM "${DYNAMODB_PID}" 2>/dev/null || true
    wait "${DYNAMODB_PID}" 2>/dev/null || true
  fi
}

trap shutdown TERM INT

echo "Starting DynamoDB Local..."
cd /home/dynamodblocal
java -jar DynamoDBLocal.jar -port "${DYNAMODB_PORT}" -sharedDb -inMemory &
DYNAMODB_PID=$!

echo "Waiting for DynamoDB Local to be ready..."
attempt=1
while ! aws dynamodb list-tables --endpoint-url "${DYNAMODB_ENDPOINT}" >/dev/null 2>&1; do
  if ! kill -0 "${DYNAMODB_PID}" 2>/dev/null; then
    echo "DynamoDB Local exited unexpectedly"
    wait "${DYNAMODB_PID}" || true
    exit 1
  fi
  if [ "${attempt}" -ge "${max_attempts}" ]; then
    echo "Timed out waiting for DynamoDB Local"
    shutdown
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 1
done
echo "DynamoDB Local is ready"

echo "Creating table ${TABLE_NAME}..."
aws dynamodb create-table \
  --table-name "${TABLE_NAME}" \
  --attribute-definitions AttributeName=id,AttributeType=S \
  --key-schema AttributeName=id,KeyType=HASH \
  --billing-mode PAY_PER_REQUEST \
  --endpoint-url "${DYNAMODB_ENDPOINT}" \
  >/dev/null
echo "Table ${TABLE_NAME} created"

echo "Populating table ${TABLE_NAME}..."
aws dynamodb batch-write-item \
  --request-items "file://${FIXTURES_FILE}" \
  --endpoint-url "${DYNAMODB_ENDPOINT}" \
  >/dev/null
echo "Table ${TABLE_NAME} populated"

echo "DynamoDB Local setup complete"

wait "${DYNAMODB_PID}"
