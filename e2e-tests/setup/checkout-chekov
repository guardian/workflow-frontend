#!/usr/bin/env bash

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
E2E_ROOT_DIR=${DIR}/..

if ! command -v git >/dev/null 2>&1; then
  echo "Git CLI is required to check out the chekov repository" >&2
  exit 1
fi

# Check out (or update) guardian/chekov into a git-ignored folder
# under target/. Reused across runs: shallow-clone once, then fast-forward pull.
# The path is exported so run-local-stack.ts can consume it.
CHEKOV_DIR="${E2E_ROOT_DIR}/target/chekov"
if [ -d "${CHEKOV_DIR}/.git" ]; then
  echo "Updating chekov checkout in ${CHEKOV_DIR}"
  git -C "$CHEKOV_DIR" pull --ff-only
else
  echo "Cloning guardian/chekov into ${CHEKOV_DIR}"
  git clone --depth 1 git@github.com:guardian/chekov.git "$CHEKOV_DIR"
fi
export CHEKOV_DIR